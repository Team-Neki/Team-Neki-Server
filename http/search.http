### [PB-4] 지역 keyword + 브랜드 "서울특별시 강남구 포토이즘" : 강남구의 포토이즘만
POST {{host}}/api/search/photo-booths
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "keyword": "서울특별시 강남구 포토이즘",
  "filterGroup": {}
}

> {%
  client.test("PB-4", function () {
    client.assert(response.status === 200, "status " + response.status);
    var items = response.body.data.items;
    client.assert(items.length > 0, "items 가 비어 있음");
    items.forEach(function (i) { client.assert(i.brandCode === "PHOTOISM", "포토이즘이 아닌 부스 : " + i.id); });
    client.assert(items.length <= Number(client.global.get("regionCount")), "강남구 전체보다 많음");
    client.global.set("freeTextIds", JSON.stringify(items.map(function (i) { return i.id; }).sort()));
  });
%}

