### [FT-1] 강남: 포토이즘 4, 인생네컷 2
POST {{host}}/api/search/filter?keyword=강남
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "filterGroup": {}
}

> {%
  client.test("FT-1", function () {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(response.body.resultCode === "D-0", "resultCode " + response.body.resultCode);
    var f = response.body.data.brandFilter;
    client.assert(f.length === 2, "size " + f.length);
    client.assert(f[0].id === 1 && f[0].code === "PHOTOISM" && f[0].count === 4, "brandFilter[0] " + JSON.stringify(f[0]));
    client.assert(f[1].id === 2 && f[1].code === "LIFEFOURCUTS" && f[1].count === 2, "brandFilter[1] " + JSON.stringify(f[1]));
  });
  client.global.set("ft1", JSON.stringify(response.body));
%}

### [FT-2] 다른 검색어 + 브랜드 필터: FT-1 과 같은 body
POST {{host}}/api/search/filter?keyword=송정
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "filterGroup": {
    "brandFilter": { "brands": [{ "brandId": 2 }] }
  }
}

> {%
  client.test("FT-2", function () {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(JSON.stringify(response.body) === client.global.get("ft1"), "body differs from FT-1");
  });
%}

