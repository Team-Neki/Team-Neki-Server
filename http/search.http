### [C-3] 부스 자동완성 : "모노맨션 강남" 의 첫 후보 keyword(브랜드명 지점명)를 저장
GET {{host}}/api/search/completion/photo-booths?keyword=모노맨션%20강남
Authorization: Bearer {{accessToken}}

> {%
  client.test("C-3", function () {
    client.assert(response.status === 200, "status " + response.status);
    var items = response.body.data.items;
    client.assert(items.length > 0, "부스 후보가 없음");
    client.global.set("boothKeyword", items[0].keyword);
    client.log("C-3 boothKeyword=" + items[0].keyword);
  });
%}

### [PB-11] 부스 keyword : 그 지점만 (보통 1건, 같은 브랜드에 같은 지점명이 둘이면 둘)
POST {{host}}/api/search/photo-booths
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "keyword": "{{boothKeyword}}",
  "filterGroup": {}
}

> {%
  client.test("PB-11", function () {
    client.assert(response.status === 200, "status " + response.status);
    var items = response.body.data.items;
    var keyword = client.global.get("boothKeyword");
    client.assert(items.length >= 1, "items 가 비어 있음 : " + keyword);
    items.forEach(function (i) {
      client.assert(i.brandName + " " + i.branchName === keyword, "다른 지점 : " + i.brandName + " " + i.branchName);
    });
    var idsByName = JSON.parse(client.global.get("brandIdsByName"));
    var boothBrandId = idsByName[items[0].brandName];
    var otherBrandId = Object.keys(idsByName).map(function (n) { return idsByName[n]; })
      .filter(function (id) { return id !== boothBrandId; })[0];
    client.global.set("boothBrandId", String(boothBrandId));
    client.global.set("otherBrandId", String(otherBrandId));
    client.global.set("boothCount", String(items.length));
  });
%}

### [PB-12] 부스 keyword + 그 지점의 브랜드 필터 : PB-11 과 같은 결과
POST {{host}}/api/search/photo-booths
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "keyword": "{{boothKeyword}}",
  "filterGroup": {
    "brandFilter": { "brands": [{ "brandId": {{boothBrandId}} }] }
  }
}

> {%
  client.test("PB-12", function () {
    client.assert(response.status === 200, "status " + response.status);
    client.assert(String(response.body.data.items.length) === client.global.get("boothCount"), "PB-11 과 건수가 다름");
  });
%}

