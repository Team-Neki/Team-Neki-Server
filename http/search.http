### [F-3] 부스 keyword 필터 : 그 브랜드 하나, count = PB-11 건수
POST {{host}}/api/search/filter
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "keyword": "{{boothKeyword}}",
  "filterGroup": {}
}

> {%
  client.test("F-3", function () {
    client.assert(response.status === 200, "status " + response.status);
    var chips = response.body.data.brandFilter;
    client.assert(chips.length === 1, "칩이 하나가 아님 : " + JSON.stringify(chips));
    client.assert(String(chips[0].id) === client.global.get("boothBrandId"), "다른 브랜드 칩");
    client.assert(String(chips[0].count) === client.global.get("boothCount"), "count 가 PB-11 건수와 다름");
  });
%}

### [FAV-1] PB-1 에서 즐겨찾기 안 한 부스를 즐겨찾기 (FAV-3 에서 되돌림)
PATCH {{host}}/api/photo-booths/{{favTargetId}}/favorite
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "favorite": true
}

> {%
  client.test("FAV-1", function () {
    client.assert(response.status === 200, "status " + response.status);
  });
%}

### [FAV-2] 다시 조회하면 그 부스의 favorite = true
POST {{host}}/api/search/photo-booths
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "keyword": "서울특별시 강남구",
  "filterGroup": {}
}

> {%
  client.test("FAV-2", function () {
    client.assert(response.status === 200, "status " + response.status);
    var targetId = Number(client.global.get("favTargetId"));
    var target = response.body.data.items.filter(function (i) { return i.id === targetId; })[0];
    client.assert(target !== undefined && target.favorite === true, "favorite 가 반영되지 않음 : " + targetId);
  });
%}

### [FAV-3] 즐겨찾기를 되돌린다
PATCH {{host}}/api/photo-booths/{{favTargetId}}/favorite
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "favorite": false
}

> {%
  client.test("FAV-3", function () {
    client.assert(response.status === 200, "status " + response.status);
  });
%}
