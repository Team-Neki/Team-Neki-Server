### [BK-8] 부스 자동완성 "서울특별시 강남구 포토이즘" : 첫 후보 저장
GET {{host}}/api/search/completion/photo-booths?keyword=서울특별시%20강남구%20포토이즘
Authorization: Bearer {{accessToken}}

> {%
  client.test("BK-8", function () {
    client.assert(response.status === 200, "status " + response.status);
    var keywords = response.body.data.items.map(function (i) { return i.keyword; });
    client.log("BK-8 candidates=" + JSON.stringify(keywords));
    client.assert(keywords.length > 0, "부스 후보가 없음");
    client.global.set("boothPick", keywords[0]);
    client.global.set("boothPickParam", encodeURIComponent(keywords[0]));
  });
%}

### [BK-9] BK-8 첫 후보로 부스 목록 : 그 포토이즘 지점만
POST {{host}}/api/search/photo-booths?keyword={{boothPickParam}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "filterGroup": {}
}

> {%
  client.test("BK-9", function () {
    client.assert(response.status === 200, "status " + response.status);
    var items = response.body.data.items;
    var keyword = client.global.get("boothPick");
    client.log("BK-9 keyword=" + keyword + " items=" + JSON.stringify(items.map(function (i) { return i.brandName + " " + i.branchName; })));
    client.assert(items.length > 0, "items 가 비어 있음");
    items.forEach(function (i) {
      client.assert(i.brandName === "포토이즘", "포토이즘이 아닌 부스 : " + i.brandName);
      client.assert(i.brandName + " " + i.branchName === keyword, "고른 지점이 아닌 부스 : " + i.branchName);
    });
  });
%}
